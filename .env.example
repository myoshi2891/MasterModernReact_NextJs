# Supabase (browser/client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=

# Supabase (server)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth.js (Google OAuth)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Structured Logging (required in production)
# Used for hashing sensitive data in logs. Generate with: openssl rand -hex 32
HASH_SALT=

# Optional
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
TZ=Asia/Tokyo
# ローカル開発で NAT64 解決により Next.js 画像最適化が失敗する場合に true にする
# NEVER set true in production or CI
# NEXT_IMAGES_DANGEROUSLY_ALLOW_LOCAL_IP=true
